# Your patch layer for this dsh profile, applied after every bundle layer:
# a top-level YAML array of loader patch entries (id-targeted config
# overrides, disables, and insert lists; `!!js` expressions allowed).
- { id: computer-use-cua-driver-native, disabled: true }
- id: ui-settings-general
  name: "@deepseek-ai/dsh-client-ui-settings-general"
  config:
    welcomeNoticeVersion: 2026-08-13.1
- id: agent-default-model
  name: "@deepseek-ai/dsh-agent-default-model"
  config:
    provider: workbuddy
    model: deepseek-v4.1-flash
    reasoningEffort: low
- id: permission
  name: "@deepseek-ai/dsh-permission-presets"
  config:
    presets:
      read-only:
        sandbox: read-only
        approval: ask
      workspace-write:
        sandbox: workspace-write
        approval: ask
      danger-full-access:
        sandbox: danger-full-access
        approval: never
    defaultPreset: danger-full-access
# 远程访问（cloudflared 隧道 / 远程桌面授权）插件：按用户要求禁用，永不挂载。
# 该行由 @linxin666/dsh-web-all 的 bundle 层插入，本条用户层覆盖其后生效。
- { id: web-ui-remote-web-ui, disabled: true }
# 以下三行上游默认关闭（opt-in）；用户要求「其他的都安装」，故在用户层显式开启。
- { id: web-ui-ssh, disabled: false }
- { id: web-ui-liangshen, disabled: false }
- { id: web-ui-skill-explorer, disabled: false }
- id: web-ui-skin-center
  name: "@linxin666/dsh-client-ui-skin-center"
  config:
    skin-custom-theme:
      applied: false
    skin-wallpaper:
      enabled: false
- id: ui-theme
  name: "@deepseek-ai/dsh-client-ui-theme"
  config:
    preference: light
- id: ui-settings-account
  name: "@deepseek-ai/dsh-client-ui-settings-account"
  config:
    version: 1
    step: done
    purpose: development
    process: standard
    completion: completed
    usage: detailed
    developerTools: true
- id: ui-chat
  name: "@deepseek-ai/dsh-client-ui-chat"
  config:
    transcriptView: standard
    performanceUsage: detailed
    linkOpening: new-tab
- id: ui-settings
  name: "@deepseek-ai/dsh-client-ui-settings"
  config:
    enabled: true
- id: web-ui-pet
  name: "@linxin666/dsh-pet"
  config:
    visible: true
    size: 160
    right: 65
    bottom: 88
    petId: whale-girl-refined
- id: web-ui-usage
  name: "@linxin666/dsh-web-all/usage"
  config:
    plugin: "@linxin666/dsh-usage"
    enabled: true
- id: subagent
  name: "@deepseek-ai/dsh-subagent"
  config:
    maxActiveSubagents: 16
- id: agent-loop
  name: "@deepseek-ai/dsh-agent-loop"
  config:
    agents: []
    maxParallelToolCalls: 25
# Bounds private reasoning: a system-prompt section that tells the model to stop
# re-opening settled decisions. See reasoning-budget.mjs for the measurements behind
# it and for the revert note (delete this row and the file).
- insert:
    - id: reasoning-budget
      name: ./reasoning-budget.mjs
      config:
        enabled: true
        order: 10150
# ---------------------------------------------------------------------------
# INERT DOCUMENTATION ONLY — every line below is a comment. It adds no rows, no
# config and no behaviour; delete the whole block freely, nothing depends on it.
# Evidence: node E:\fast-dsh\tools\verify-profile-patch.mjs
#
# Tool-surface trimming (team dsh-latency, task t4) is owned by the bundle
# `@local/fast-deepseek-harness` (E:\fast-dsh\plugins\fast-deepseek-harness).
# That bundle
# installs its own patch row and prunes tools per agent at runtime through
# `agent.ctx.tools.restrict()` — it never edits this file. Bundle patches
# compose at boot from the profile's bundle list, so NOTHING has to be added
# here for the plugin itself.
#
# DO NOT disable tool rows in this file. The bundle's `preset: safe` (shipped
# default) already masks `hindsight_*` (8 tools / 6,495 chars) and `ssh_*`
# (6 tools / 4,596 chars) for every new agent. Verified live: a fresh agent
# sees 63 tools instead of the global 77, with hindsight_* = 0 and ssh_* = 0.
# A `disabled: true` here would duplicate that, and for `web-ui-ssh` it would
# also kill the SSH UI panel that line 33 above deliberately re-enables.
#
# Row ids in THIS profile (the aggregate carrier @linxin666/dsh-web-all is what
# is installed, so its rows are namespaced `web-ui-*`):
#   cordis.yml:1273  web-ui-task-board   -> @linxin666/dsh-web-all/task-board
#   cordis.yml:1290  web-ui-ssh          -> @linxin666/dsh-web-all/ssh
#   cordis.yml:1345  hindsight           -> @vectorize-io/hindsight-coding-agents/dsh
#   cordis.yml:1347  agent-teams
# The bare ids `ui-task-board` and `ssh` (from the standalone packages' own
# patches) DO NOT EXIST here. Writing them is a silent no-op: zero tools
# pruned, zero savings, no error anywhere. Do not copy them from
# work/tool-audit.md.
#
# The only schema-cost lever not already taken is the task-board group
# (8 tools / 12,694 chars ~ 3,327 tokens per request at 3.815 chars/token).
# Prefer the bundle's one-word opt-in over disabling a row: set
# `preset: balanced` in E:\fast-dsh\plugins\fast-deepseek-harness\cordis.patch.yml
# (revert: set it back to `safe`, then reinstall that bundle). That reclaims
# the same tokens per agent while keeping the GUI board alive.
# HONEST FRAMING: tool-schema pruning buys TOKENS and COST, not proven
# latency. The audit found no direct evidence that schema size moves ttft; the
# extrapolated upper bound is 108-203 ms/step and counter-evidence weakens it.
# ---------------------------------------------------------------------------
- id: subagent-model-selection-settings
  name: "@deepseek-ai/dsh-tool-subagent/model-selection-settings"
  config:
    enabled: true
    allowedModels:
      - provider: workbuddy
        model: deepseek-v4.1-flash
      - provider: workbuddy
        model: glm-5.3-flash
      - provider: workbuddy
        model: minimax-m3-pay
      - provider: workbuddy
        model: hy4-preview-f
      - provider: workbuddy
        model: space-bunny
